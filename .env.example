NEXT_PUBLIC_SITE_URL=https://dopelab.studio
# BLOG_BASE_PATH=/blog  (optional; unset = /blog; any other value fails the build, BM-04)
# BLOG_ASSET_PREFIX=https://<asset-host>/blog  (production env only, set by Helm at Gate 2; ignored on preview builds, ADR-01 X4;
#   drives assetPrefix, images.path and every raw <img> src (X4-f); inlined at build: set the same value for build and runtime)
# BLOG_NOINDEX=1  (Gate 1; "0"/unset = indexable; any other value fails the build; build-time, needs a rebuild, BM-05)
# INK_REDIRECT_MODE=off|temporary|permanent  (ADR-01; "off" = ink-shaped canonical for rollback R-b; any other value fails the build, BM-05)
